meta {
  name: Get current user
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("me returns the signed-in user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getVar("email"));
    expect(res.body.verified).to.equal(false);
  });
}

docs {
  Returns the profile for the saved access token. Without a valid token the
  service answers 401.
}
