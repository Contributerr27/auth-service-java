meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.token);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("login returns a token pair", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.token).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}

docs {
  Logs in as the user created by "Signup" (run Signup first) and refreshes the
  saved tokens. Limited to 10 requests per 10 minutes per client IP.
}
