meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  // A fresh address on every run, so signup never returns 409.
  bru.setVar("email", "bruno-" + Date.now() + "@example.com");
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.token);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("signup returns a token pair", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.token).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}

docs {
  Registers a new user with a generated email and saves the access and refresh
  tokens into collection variables. Limited to 10 requests per 10 minutes per
  client IP (429 with a Retry-After header after that).
}
